<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <!-- Default: the synchronous (PHP-FPM / CLI) driver. Runs everywhere. -->
        <testsuite name="default">
            <directory>tests/Unit</directory>
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- OpenSwoole coroutine runtime (requires the openswoole extension). -->
        <testsuite name="openswoole">
            <directory>tests/Runtime/OpenSwoole</directory>
        </testsuite>
        <!-- FrankenPHP / Amp fiber runtime (requires revolt/event-loop). -->
        <testsuite name="frankenphp">
            <directory>tests/Runtime/FrankenPHP</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
